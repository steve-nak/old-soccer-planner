{
  "name": "soccer-planner",
  "description": "Soccer Planner app: plan and organize pickup soccer matches",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=soccer-web\" \"npm run start --workspace=soccer-mobile\"",
    "build": "npm run build --workspace=soccer-web",
    "db:generate": "npm run db:generate --workspace=soccer-web",
    "db:migrate": "npm run db:migrate --workspace=soccer-web",
    "db:seed": "npm run db:seed --workspace=soccer-web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "workspaces": [
    "soccer-web",
    "soccer-mobile"
  ]
}
